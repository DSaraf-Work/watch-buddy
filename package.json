{
  "name": "watch-buddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "./scripts/start-dev.sh",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "./scripts/deploy.sh",
    "cf-typegen": "./scripts/wrangler-personal.sh types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "./scripts/wrangler-personal.sh d1 migrations apply DATABASE --local",
    "db:migrate:remote": "./scripts/wrangler-personal.sh d1 migrations apply DATABASE --remote",
    "db:seed:platforms:local": "./scripts/wrangler-personal.sh d1 execute DATABASE --local --file=scripts/seed-platforms.sql",
    "db:seed:platforms:remote": "./scripts/wrangler-personal.sh d1 execute DATABASE --remote --file=scripts/seed-platforms.sql",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "^1.6.25",
    "better-auth-cloudflare": "^0.3.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.400.0",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "wrangler": "^4.118.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
