{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-buddy",
  "account_id": "2f06d6d6e20bbf55eb28d06f6e6b3b6a",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "watch-buddy"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "watch-buddy-db",
      "database_id": "1675c5d6-b5dc-454f-8958-9e9a513c214e",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b36a27f0d91a41ad90d582385a22793e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "watch-buddy-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://watch-buddy.geass.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://watch-buddy.geass.workers.dev,http://localhost:3000",
    "NEXT_PUBLIC_APP_URL": "https://watch-buddy.geass.workers.dev"
  }
}
